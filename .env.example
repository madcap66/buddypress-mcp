# BuddyPress Site Configuration
BUDDYPRESS_URL=http://buddypress.local
BUDDYPRESS_USERNAME=admin
BUDDYPRESS_PASSWORD=your-application-password-here

# Usage:
# 1. Copy this file to .env
# 2. Update the values with your BuddyPress site credentials
# 3. Create an Application Password in WordPress (Users → Profile → Application Passwords)
# 4. Use the Application Password, not your regular WordPress password
